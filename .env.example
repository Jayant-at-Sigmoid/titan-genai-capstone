# AWS Credentials (If using real Bedrock runtime)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_REGION=us-east-1

# Bedrock Model Identifiers
BEDROCK_TEXT_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_FAST_MODEL=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# Application Configurations
# Set to 'True' to force simulation mode without Bedrock APIs
SIMULATION_MODE=True
PORT=8501
DATABASE_URL=sqlite:///compliance.db
